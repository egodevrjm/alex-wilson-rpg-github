  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "mcp-handler": "^1.0.0",
    "next": "^15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.0.12",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
