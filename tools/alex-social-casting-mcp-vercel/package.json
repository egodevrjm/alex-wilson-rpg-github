{
  "name": "alex-social-casting-mcp-vercel-wrapper",
  "version": "0.2.0",
  "private": true,
  "description": "Vercel-deployable wrapper that unpacks the Alex Social Casting remote MCP at build time.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/unpack.js && next dev",
